+    (defined(__i386__) || (defined(__x86_64__) && !defined(__ILP32__)))
   void *pc = inline_func();  // Must be inlined.
   const char *symbol = TrySymbolize(pc);
   ASSERT_NE(symbol, nullptr) << "TestWithPCInsideInlineFunction failed";
